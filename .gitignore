# secrets — never commit
.env
*.key
**/oa_key*
# artifacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.aris/
*.log
pilot/results_*.json
pilot/battery.json
demo_*.log
devtraj_results.json
server_env.sh
.venv*/

# downloaded model weights and generated training artifacts
*.safetensors
*.bin
*.pt
*.pth
data/results/**
!data/results/master_table.md
!data/results/metacog_alignment_yes_rate_audit_seed0.md
!data/results/metacog_alignment_campaign_seed0_retry1/
data/results/metacog_alignment_campaign_seed0_retry1/**
!data/results/metacog_alignment_campaign_seed0_retry1/report/
!data/results/metacog_alignment_campaign_seed0_retry1/report/M1_GATE_REPORT.md
data/.hfds_tmp/
data/benchmarks/*-metacog*/

# external/reference artifacts
arXiv-*.tar.gz
paper/
exemplar_paper/

# ---------------------------------------------------------------------------
# A100 confirmatory campaigns (2026-08-29): track the evidence, never the weights.
# Each directory level has to be re-included explicitly, because git does not
# descend into an excluded directory and a bare "!.../**" would never match.
!data/results/results_v1f_qwen3-8B.json
!data/results/results_v2f_qwen3-8B.json
!data/results/results_v2g2_qwen3-8B.json
!data/results/results_v3f_qwen3-8B.json
!data/results/results_v4f_qwen3-8B.json
!data/results/results_v*_qwen3-8B.json.metadata
!data/results/a100_handoff/
!data/results/a100_handoff/**
!data/results/metacog_a100_3seed/
!data/results/metacog_a100_3seed/**
!data/results/rlqa_a100/
!data/results/rlqa_a100/**


# 32B scaling gates and the scale sweep (2026-08-30): same rule, evidence in,
# weights out. The checkpoint/tokenizer exclusions above already apply here.
!data/results/results_v*_qwen3-32B.json
!data/results/results_v*_qwen3-32B.json.metadata
!data/results/metacog32_a100_seed0/
!data/results/metacog32_a100_seed0/**
!data/results/rlqa32_a100/
!data/results/rlqa32_a100/**
!data/results/scale_sweep/
!data/results/scale_sweep/**
!data/results/scale_sweep_diagnostic/
!data/results/scale_sweep_diagnostic/**

# ---------------------------------------------------------------------------
# Trained artefacts stay out, and this block is LAST so it always wins over the
# re-inclusion rules above. A negation placed after these would silently pull
# every LoRA checkpoint back in.
data/results/**/checkpoints/
data/results/**/canary/
data/results/**/best-step-*/
# the RL trainer also emits periodic checkpoint-<step>/ saves (singular)
data/results/**/checkpoint-*/
data/results/**/final_adapter/
data/results/**/tokenizer/
